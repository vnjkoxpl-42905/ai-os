# ai-os environment variables
# Secrets live here and only here. Never paste a key into a note, a commit, or a chat.
# Not committed: covered by .gitignore.

# --- Web access -------------------------------------------------------------
FIRECRAWL_API_KEY=fc-your-key-here

# --- LSAT U backend (Lovable Cloud / Supabase admin) ------------------------
# Used by lsat-u-platform-actions, send-booking-link, pull-submissions,
# guided-drill-assignment. Auth against the public auth API, then call
# PostgREST + edge functions with the returned JWT (expires 3600s; re-auth).
LSATPREP_ADMIN_EMAIL=you@example.com
LSATPREP_ADMIN_PASSWORD=your-password-here

# --- Add connections below as you wire them up ------------------------------
# TAVILY_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Cal.com API v2 — https://app.cal.com/settings/developer/api-keys
CALCOM_API_KEY=
