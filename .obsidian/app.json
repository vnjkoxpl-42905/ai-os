{
  "userIgnoreFilters": [
    "raw/",
    "projects/",
    "graph-imports/",
    "tmp/",
    "archive/",
    "node_modules/",
    ".git/"
  ],
  "alwaysUpdateLinks": true,
  "newLinkFormat": "shortest",
  "useMarkdownLinks": false,
  "attachmentFolderPath": "system/attachments",
  "showUnsupportedFiles": false,
  "promptDelete": true,
  "trashOption": "system",
  "spellcheck": true,
  "readableLineLength": true,
  "strictLineBreaks": false,
  "showLineNumber": false,
  "foldHeading": true,
  "foldIndent": true,
  "showInlineTitle": true,
  "defaultViewMode": "source",
  "livePreview": true
}