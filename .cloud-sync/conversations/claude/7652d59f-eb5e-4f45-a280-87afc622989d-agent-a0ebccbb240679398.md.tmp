    59	
    60	export function RcQuestionPane({
    61	  item,
    62	  selected,
    63	  eliminations,
    64	  revealed,
    65	  reattemptMode,
    66	  reattemptPick,
    67	  flagged,
    68	  onToggleFlag,
    69	  onSelect,
    70	  onToggleElimination,
    71	  onSkipToAnswer,
    72	  type,
    73	  highlights,
    74	  color,
    75	  onColorChange,
    76	  highlightMode,
    77	  onAddHighlight,
    78	  onRemoveHighlight,
    79	  onRemoveRange,
    80	}: Props) {
    81	  const { question } = item;
    82	  const [openLetters, setOpenLetters] = React.useState<Set<string>>(() => new Set());
    83	
    84	  const paneRef = React.useRef<HTMLDivElement>(null);
    85	  const stemRef = React.useRef<HTMLDivElement>(null);
    86	  // One popover for the pane. Its state is this pane's own: the passage pane
    87	  // keeps its own, so a selection here never moves a popover there.
    88	  const [popover, setPopover] = React.useState<Popover | null>(null);
    89	  const onAnchor = React.useCallback(
    90	    (anchor: RcSelectionAnchor | null, surface: RcMarkSurfaceHandle) =>
    91	      setPopover(anchor ? { anchor, surface } : null),
    92	    [],
    93	  );
    94	
    95	  const stemTarget = questionTarget(question.questionId, 'stem');
    96	  const stemHighlights = React.useMemo(
    97	    () => highlights.filter((h) => h.target === stemTarget),
    98	    [highlights, stemTarget],
    99	  );
   100	  React.useLayoutEffect(() => {
   101	    const el = stemRef.current;
   102	    if (el) paintRcAnnotations(el, stemHighlights);
   103	  }, [question.questionId, question.prompt, stemHighlights]);
   104	
   105	  const stem = useRcMarkSurface({
   106	    textRef: stemRef,
   107	    paneRef,
   108	    highlightMode,
   109	    color,
   110	    onAdd: (start, end, chosen, kind) => onAddHighlight(stemTarget, start, end, chosen, kind),
   111	    onRemove: (offset) => onRemoveHighlight(stemTarget, offset),
   112	    onRemoveRange: (start, end) => onRemoveRange(stemTarget, start, end),
   113	    onAnchor,
   114	  });
   115	
   116	  /** A release anywhere else in the pane puts the popover away. */
   117	  const dismissOutsideSurfaces = (event: React.MouseEvent) => {
   118	    const el = event.target as HTMLElement;
   119	    if (el.closest('[data-rc-mark-surface], .rc-selection-popover')) return;
   120	    setPopover(null);
   121	  };
   122	
   123	  React.useEffect(() => {
   124	    if (!revealed) {
   125	      setOpenLetters(new Set());
   126	      return;
   127	    }
   128	    // The credited answer and the student's own pick open themselves.
   129	    const next = new Set<string>([question.correctAnswer]);
   130	    if (selected) next.add(selected);
   131	    if (reattemptPick) next.add(reattemptPick);
   132	    setOpenLetters(next);
   133	  }, [question.questionId, question.correctAnswer, revealed, selected, reattemptPick]);
   134	
   135	  const showFeedback = revealed && !reattemptMode;
   136	
   137	  return (
   138	    <div
   139	      className="rc-exam-col relative min-w-0 overflow-y-auto px-6 py-7 sm:pl-10 sm:pr-8"
   140	      style={type.question}
   141	      ref={paneRef}
   142	      onMouseUp={dismissOutsideSurfaces}
   143	    >
   144	      {reattemptMode && (
   145	        <div className="rc-reattempt-banner">
   146	          <span>
   147	            Your answer is hidden. Pick again, then see both.
   148	          </span>
   149	          <button type="button" className="rc-skip-link" onClick={onSkipToAnswer}>
   150	            Show my answer
   151	          </button>
   152	        </div>
   153	      )}
   154	
   155	      <div className="flex items-start justify-between gap-3">
   156	        <div className="flex flex-1 items-start gap-2">
   157	          <span className="min-w-[20px] shrink-0 font-bold tabular-nums">{item.number}.</span>
   158	          {/* Unexplained questions carry no authored prompt. The number stands
   159	              in rather than inventing a stem. The mouse-up sits on this div,
   160	              not the row: the flag button beside it is not markable text.
   161	              Keyed on the question so a new stem mounts fresh text nodes;
   162	              painting splits the ones React rendered, and React would patch
   163	              the first fragment in place and leave the rest behind. */}
   164	          <div
   165	            key={question.questionId}
   166	            className="flex-1 [&_p]:m-0"
   167	            ref={stemRef}
   168	            data-rc-mark-surface
   169	            onMouseUp={question.prompt ? stem.onMouseUp : undefined}
   170	          >
   171	            {question.prompt ? <RcMarkdown>{question.prompt}</RcMarkdown> : <p>&nbsp;</p>}
   172	          </div>
   173	        </div>
   174	        <button
   175	          type="button"
   176	          onClick={onToggleFlag}
   177	          aria-pressed={flagged}
   178	          aria-label={flagged ? 'Remove flag' : 'Flag question'}
   179	          title={flagged ? 'Remove flag' : 'Flag question'}
   180	          className={cn(
   181	            'shrink-0 rounded p-1.5 transition-colors',
   182	            flagged ? 'bg-amber-100' : 'hover:bg-slate-100',
   183	          )}
   184	        >
   185	          <Flag
   186	            className={cn('h-[24px] w-[24px] transition-colors', flagged && 'fill-amber-400')}
   187	            strokeWidth={2}
   188	          />
   189	        </button>
   190	      </div>
   191	
   192	      {showFeedback && (
   193	        <RcReviewLayer
   194	          question={question}
   195	          firstPick={selected}
   196	          secondPick={reattemptPick ?? undefined}
   197	        />
   198	      )}
   199	
   200	      <ul className="mt-4 space-y-3.5">
   201	        {question.choices.map((choice) => {
   202	          /* Blind means blind. `reattemptPick ?? selected` fell back to the
   203	             original answer while the student was being asked to answer again,
   204	             so the pane highlighted the very choice it was hiding — the
   205	             re-attempt was answering itself. */
   206	          const isPicked = reattemptMode
   207	            ? reattemptPick === choice.letter
   208	            : (reattemptPick ?? selected) === choice.letter;
   209	          return (
   210	            <RcChoiceRow
   211	              key={choice.letter}
   212	              choice={choice}
   213	              questionId={question.questionId}
   214	              selected={isPicked}
   215	              eliminated={
   216	                // Hidden outright while they answer again, and never drawn on
   217	                // the choice they have just picked: a row that is selected AND
   218	                // struck through reads as "you crossed out your own answer",
   219	                // when what happened is that they landed on a choice they had
   220	                // eliminated the first time round.
   221	                !reattemptMode && !isPicked && eliminations.includes(choice.letter)
   222	              }
   223	              revealed={showFeedback}
   224	              disabled={showFeedback}
   225	              eliminationDisabled={reattemptMode}
   226	              onSelect={onSelect}
   227	              onToggleElimination={onToggleElimination}
   228	              textStyle={type.choiceText}
   229	              badgeStyle={type.choiceBadge}
   230	              highlights={highlights}
   231	              color={color}
   232	              highlightMode={highlightMode}
   233	              onAddHighlight={onAddHighlight}
   234	              onRemoveHighlight={onRemoveHighlight}
   235	              onRemoveRange={onRemoveRange}
   236	              onAnchor={onAnchor}
   237	              paneRef={paneRef}
   238	            >
   239	              {showFeedback && (
   240	                <RcChoiceDisclosure
   241	                  choice={choice}
   242	                  isPicked={isPicked}
   243	                  open={openLetters.has(choice.letter)}
   244	                  onToggle={() =>
   245	                    setOpenLetters((prev) => {
   246	                      const next = new Set(prev);
   247	                      if (next.has(choice.letter)) next.delete(choice.letter);
   248	                      else next.add(choice.letter);
   249	                      return next;
   250	                    })
   251	                  }
   252	                />
   253	              )}
   254	            </RcChoiceRow>
   255	          );
   256	        })}
   257	      </ul>
   258	
   259	      <RcSelectionPopover
   260	        anchor={popover?.anchor ?? null}
   261	        color={color}
   262	        onColorChange={onColorChange}
   263	        onApply={(chosen) => popover?.surface.applyPending(chosen)}
   264	        onRemove={() => popover?.surface.removePending()}
   265	        onDismiss={() => setPopover(null)}
   266	      />
   267	    </div>
   268	  );
   269	}
   270	
   271	export default RcQuestionPane;

