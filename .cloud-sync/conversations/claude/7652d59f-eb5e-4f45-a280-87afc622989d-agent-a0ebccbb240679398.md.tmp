{"command": "SP=\"C:/Users/Joshu/AppData/Local/Temp/claude/C--Users-Joshu-dev-ai-os/7652d59f-eb5e-4f45-a280-87afc622989d/scratchpad\"; REPO=\"C:/Users/Joshu/dev/ai-os/projects/lsatu-fix-homework-timed-launch\"; mkdir -p \"$SP/rc\"; cat > \"$SP/rc/vitest.skeptic.config.ts\" <<EOF\nimport { defineConfig, mergeConfig } from \"vitest/config\";\nimport base from \"$REPO/vitest.config\";\nexport default mergeConfig(base, defineConfig({\n  test: { include: [\"$SP/rc/**/*.test.tsx\"], root: \"$REPO\" },\n}));\nEOF\ncat > \"$SP/rc/overshoot.test.tsx\" <<'EOF'\nimport * as React from 'react';\nimport { fireEvent, render, screen } from '@testing-library/react';\nimport { afterEach, beforeAll, describe, expect, it, vi } from 'vitest';\nimport { RcQuestionPane } from '@/features/rc/components/RcQuestionPane';\nimport type { RcSessionItem } from '@/features/rc/lib/rcSession';\n\nconst mk = (letter: any, text: string) => ({ letter, text, tag: null, percent: null, responseCount: null, correct: letter === 'A', explanation: null });\nconst question: any = {\n  questionId: 42, position: 1, questionType: 'x', questionTypeFamily: 'x', difficulty: null,\n  prompt: 'Which one of the following best states the main point?',\n  correctAnswer: 'A', hasWrittenExplanation: false, explanationBlocks: null, totalResponses: null, features: [],\n  choices: [mk('A', 'Alpha choice text.'), mk('B', 'Bravo choice text.'), mk('C', 'Charlie choice text.'), mk('D', 'Delta choice text.'), mk('E', 'Echo choice text.')],\n};\nconst item: RcSessionItem = { question, passage: { passageId: 1 } as any, number: 1, passageIndex: 0 };\nconst type: any = { passage: {}, question: {}, choiceText: {}, choiceBadge: {} };\n\nbeforeAll(() => {\n  if (!('getBoundingClientRect' in Range.prototype)) {\n    Object.defineProperty(Range.prototype, 'getBoundingClientRect', { configurable: true, value: () => ({ left: 10, right: 60, top: 20, bottom: 40, width: 50, height: 20 }) });\n  }\n});\nafterEach(() => window.getSelection()?.removeAllRanges());\n\nfunction renderPane(highlightMode: any = 'yellow') {\n  const onAdd = vi.fn();\n  const onSelect = vi.fn();\n  render(<RcQuestionPane item={item} selected={null} eliminations={[]} revealed={false} reattemptMode={false} reattemptPick={null}\n    flagged={false} onToggleFlag={vi.fn()} onSelect={onSelect} onToggleElimination={vi.fn()} onSkipToAnswer={vi.fn()} type={type}\n    highlights={[]} color=\"yellow\" onColorChange={vi.fn()} highlightMode={highlightMode} onAddHighlight={onAdd} onRemoveHighlight={vi.fn()} onRemoveRange={vi.fn()} />);\n  return { onAdd, onSelect };\n}\nconst textOf = (re: RegExp) => screen.getByText(re).closest('[data-rc-mark-surface]') as HTMLElement;\nconst firstText = (el: HTMLElement) => { const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT); return w.nextNode() as Text; };\nfunction select(startEl: HTMLElement, s: number, endEl: HTMLElement, e: number) {\n  const r = document.createRange();\n  r.setStart(firstText(startEl), s); r.setEnd(firstText(endEl), e);\n  const sel = window.getSelection()!; sel.removeAllRanges(); sel.addRange(r);\n  return r;\n}\n\ndescribe('RC question pane: release outside the surface the drag started in', () => {\n  it('control: drag inside B released on B marks q42:B', () => {\n    const { onAdd } = renderPane();\n    const b = textOf(/Bravo/);\n    select(b, 0, b, 11);\n    fireEvent.mouseUp(b);\n    expect(onAdd).toHaveBeenCalledWith('q42:B', 0, 11, 'yellow', 'highlight');\n  });\n  it('(a) drag from B released on C row text: nothing marked, selection left standing', () => {\n    const { onAdd } = renderPane();\n    const b = textOf(/Bravo/); const c = textOf(/Charlie/);\n    select(b, 0, c, 7);\n    fireEvent.mouseUp(c);\n    expect(onAdd).not.toHaveBeenCalled();\n    expect(window.getSelection()!.isCollapsed).toBe(false);\n  });\n  it('(a2) drag inside B released on B li padding (target = li): nothing marked', () => {\n    const { onAdd } = renderPane();\n    const b = textOf(/Bravo/);\n    select(b, 0, b, 11);\n    fireEvent.mouseUp(b.closest('li')!);\n    expect(onAdd).not.toHaveBeenCalled();\n    expect(window.getSelection()!.isCollapsed).toBe(false);\n  });\n  it('(b) drag from stem released on A: nothing marked in either', () => {\n    const { onAdd } = renderPane();\n    const stem = textOf(/main point/); const a = textOf(/Alpha/);\n    select(stem, 6, a, 5);\n    fireEvent.mouseUp(a);\n    expect(onAdd).not.toHaveBeenCalled();\n  });\n  it('(a3) drag inside B released on B li padding, then a click on B li: does the click pick B?', () => {\n    const { onAdd, onSelect } = renderPane('none');\n    const b = textOf(/Bravo/);\n    select(b, 0, b, 11);\n    fireEvent.mouseUp(b.closest('li')!);\n    fireEvent.click(b.closest('li')!);\n    expect(onSelect).not.toHaveBeenCalled();\n    expect(onAdd).not.toHaveBeenCalled();\n  });\n});\nEOF\ncd \"$REPO\" && npx vitest run --config \"$SP/rc/vitest.skeptic.config.ts\" 2>&1 | tail -40", "description": "Run reproduction tests for overshoot scenarios"}

