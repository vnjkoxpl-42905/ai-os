   137	      removeOffset.current = offsetOfMark(el, mark);
   138	      onAnchor(anchorFor(mark.getBoundingClientRect(), 'remove'), handle);
   139	      return;
   140	    }
   141	
   142	    if (!selection) {
   143	      onAnchor(null, handle);
   144	      return;
   145	    }
   146	
   147	    pending.current = { start: selection.start, end: selection.end };
   148	    const rect = window.getSelection()?.getRangeAt(0)?.getBoundingClientRect();
   149	    if (rect) onAnchor(anchorFor(rect, 'apply'), handle);
   150	  };
   151	
   152	  return { onMouseUp, ...handle };
