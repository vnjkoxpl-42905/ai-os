    27	  revealed: boolean;
    28	  /** State A of review: answer again before anything is shown. */
    29	  reattemptMode: boolean;
    30	  reattemptPick: RcLetter | null;
    31	  flagged: boolean;
    32	  onToggleFlag: () => void;
