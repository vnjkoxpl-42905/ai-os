     5	
     6	/**
     7	 * The mouse-up ladder for one markable surface: the passage, a question stem,
     8	 * or an answer choice. Every surface runs the same ladder so the toolbar tools,
     9	 * the eraser and the selection popover behave identically wherever the student
    10	 * releases the mouse.
    11	 *
    12	 *   erase          -> drag clears the sweep, click clears the mark under it
    13	 *   tool active    -> a selection is applied on release, no popover
    14	 *   click on mark  -> "Remove highlight" popover
    15	 *   selection      -> "Highlight" popover
    16	 *
    17	 * The popover itself belongs to the pane, since a pane with several surfaces
    18	 * (a stem and five choices) shows one popover. `onAnchor` hands the pane the
    19	 * position together with a handle back to the surface that asked, so the
    20	 * popover's buttons act on the right text.
    21	 */
    22	
    23	export interface RcMarkSurfaceHandle {
    24	  /** Popover "Highlight": paint the selection the last mouse-up captured. */
    25	  applyPending: (chosen: RcHighlightColor) => void;
    26	  /** Popover "Remove highlight": drop the mark the last mouse-up landed on. */
    27	  removePending: () => void;
    28	}
    29	
    30	export interface RcMarkSurfaceOptions {
    31	  /** The element whose rendered text the offsets are measured against. */
    32	  textRef: React.RefObject<HTMLElement | null>;
    33	  /** The positioned, scrolling ancestor the popover is anchored inside. */
    34	  paneRef: React.RefObject<HTMLElement | null>;
    35	  highlightMode: RcHighlightMode;
    36	  color: RcHighlightColor;
    37	  onAdd: (start: number, end: number, color: RcHighlightColor, kind: RcAnnotationKind) => void;
    38	  onRemove: (offset: number) => void;
    39	  onRemoveRange: (start: number, end: number) => void;
    40	  onAnchor: (anchor: RcSelectionAnchor | null, surface: RcMarkSurfaceHandle) => void;
    41	}
    42	
    43	/** Rendered-text offset of the first character inside a painted mark. */
    44	function offsetOfMark(el: HTMLElement, mark: Element): number {
    45	  const before = document.createRange();
    46	  before.selectNodeContents(el);
    47	  before.setEnd(mark, 0);
    48	  return before.toString().length;
    49	}
    50	
    51	export function useRcMarkSurface(options: RcMarkSurfaceOptions) {
    52	  // The handle is created once and read by the pane's popover later, so it
    53	  // reads the options through a ref rather than closing over one render's.
    54	  const latest = React.useRef(options);
    55	  latest.current = options;
    56	
    57	  const pending = React.useRef<{ start: number; end: number } | null>(null);
    58	  const removeOffset = React.useRef<number | null>(null);
    59	
    60	  const handle = React.useMemo<RcMarkSurfaceHandle>(() => {
    61	    const self: RcMarkSurfaceHandle = {
    62	      applyPending: (chosen) => {
    63	        if (pending.current) {
    64	          latest.current.onAdd(pending.current.start, pending.current.end, chosen, 'highlight');
    65	        }
    66	        window.getSelection()?.removeAllRanges();
    67	        latest.current.onAnchor(null, self);
    68	      },
    69	      removePending: () => {
    70	        if (removeOffset.current != null) latest.current.onRemove(removeOffset.current);
    71	        latest.current.onAnchor(null, self);
    72	      },
    73	    };
    74	    return self;
    75	  }, []);
    76	
    77	  /**
    78	   * Popover position, in the pane's content coordinates. The pane scrolls and
    79	   * the popover is positioned inside it, so the scroll offset is added back:
    80	   * client rects are measured against the viewport, not the scrolled content.
    81	   */
    82	  const anchorFor = (rect: DOMRect, mode: RcSelectionAnchor['mode']): RcSelectionAnchor => {
    83	    const pane = latest.current.paneRef.current!;
    84	    const paneRect = pane.getBoundingClientRect();
    85	    return {
    86	      x: rect.left - paneRect.left + pane.scrollLeft,
    87	      y: rect.bottom - paneRect.top + 6 + pane.scrollTop,
    88	      mode,
    89	    };
    90	  };
    91	
    92	  const onMouseUp = (event: React.MouseEvent) => {
    93	    const { textRef, highlightMode, color, onAdd, onRemove, onRemoveRange, onAnchor } =
    94	      latest.current;
    95	    const el = textRef.current;
    96	    if (!el) return;
    97	
    98	    const target = event.target as HTMLElement;
    99	    // A release on the popover's own buttons is the click that is about to
   100	    // fire. Treating it as a release on the text would dismiss the popover
   101	    // first, and the button would be gone before its click arrived.
   102	    if (target.closest('.rc-selection-popover')) return;
   103	
   104	    const mark = target.closest(`mark[${RC_HIGHLIGHT_ATTR}]`);
   105	    const selection = captureRenderedSelection(el);
   106	
   107	    // With the eraser active, a click clears the mark under it and a drag
   108	    // clears everything the sweep touches. No popover either way.
   109	    if (highlightMode === 'erase') {
   110	      if (selection) {
   111	        onRemoveRange(selection.start, selection.end);
   112	        window.getSelection()?.removeAllRanges();
   113	      } else if (mark) {
   114	        onRemove(offsetOfMark(el, mark));
   115	      }
   116	      onAnchor(null, handle);
   117	      return;
   118	    }
   119	
   120	    // A marker or the underline is active: apply on release, like the official
   121	    // interface, rather than asking again through the popover.
   122	    if (highlightMode !== 'none' && selection) {
   123	      const kind: RcAnnotationKind = highlightMode === 'underline' ? 'underline' : 'highlight';
   124	      onAdd(
   125	        selection.start,
   126	        selection.end,
   127	        kind === 'underline' ? color : (highlightMode as RcHighlightColor),
   128	        kind,
   129	      );
   130	      window.getSelection()?.removeAllRanges();
   131	      onAnchor(null, handle);
   132	      return;
   133	    }
   134	
   135	    if (!selection && mark) {
