   155	export type RcMarkSurface = ReturnType<typeof useRcMarkSurface>;
     1	/**
     2	 * Painting highlights and find-text matches onto already-rendered markdown.
     3	 *
     4	 * Highlights are stored as character offsets, never as DOM nodes, so they
     5	 * survive a reload and can be restored on any future encounter with a passage.
     6	 * The offsets are measured against the *rendered* text of the container rather
     7	 * than the raw markdown source: markdown syntax (the asterisks around
     8	 * **Passage A**) never appears on screen, so an offset into the raw string does
     9	 * not line up with anything the student can select. Rendering is deterministic
    10	 * from the same source, so rendered offsets round-trip reliably.
    11	 *
    12	 * Painting walks text nodes and wraps the overlapping slice of each one, which
    13	 * lets a highlight span element boundaries (a range crossing a bold run, say)
    14	 * without needing the range to be well-formed for surroundContents.
    15	 */
    16	
    17	import { rcHighlightColor, type RcHighlight } from './rcTypes';
    18	
    19	export const RC_HIGHLIGHT_ATTR = 'data-rc-highlight';
    20	export const RC_FIND_ATTR = 'data-rc-find';
    21	
    22	export interface RcTextRange {
    23	  start: number;
    24	  end: number;
    25	  color?: string;
    26	  /** 'highlight' or 'underline'; read by the caller's styleFor. */
    27	  kind?: string;
    28	}
    29	
    30	/** Every text node under `root`, in document order. */
    31	function textNodes(root: HTMLElement): Text[] {
    32	  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    33	  const nodes: Text[] = [];
    34	  let node = walker.nextNode();
    35	  while (node) {
    36	    nodes.push(node as Text);
    37	    node = walker.nextNode();
    38	  }
    39	  return nodes;
    40	}
    41	
    42	/**
    43	 * The current selection expressed as offsets into `container`'s rendered text.
    44	 * Returns null when there is no selection, it is collapsed, or it falls outside.
    45	 */
    46	export function captureRenderedSelection(
    47	  container: HTMLElement,
    48	): { start: number; end: number; text: string } | null {
    49	  const selection = window.getSelection();
    50	  if (!selection || selection.rangeCount === 0 || selection.isCollapsed) return null;
    51	
    52	  const range = selection.getRangeAt(0);
    53	  if (!container.contains(range.commonAncestorContainer)) return null;
    54	
    55	  const text = selection.toString();
    56	  if (!text.trim()) return null;
    57	
    58	  const before = document.createRange();
    59	  before.selectNodeContents(container);
    60	  before.setEnd(range.startContainer, range.startOffset);
    61	  const start = before.toString().length;
    62	
    63	  return { start, end: start + text.length, text };
    64	}
    65	
    66	/** Removes marks previously painted with the given attribute, restoring the text. */
    67	export function clearMarks(container: HTMLElement, attr: string): void {
    68	  const marks = Array.from(container.querySelectorAll(`mark[${attr}]`));
    69	  for (const mark of marks) {
    70	    const parent = mark.parentNode;
    71	    if (!parent) continue;
    72	    while (mark.firstChild) parent.insertBefore(mark.firstChild, mark);
    73	    parent.removeChild(mark);
    74	  }
    75	  container.normalize();
    76	}
    77	
    78	/**
    79	 * Wraps each range in a <mark>. Ranges are in rendered-text coordinates.
    80	 * Existing marks with the same attribute are cleared first, so this is
    81	 * idempotent and safe to call on every render.
    82	 */
    83	export function paintRanges(
    84	  container: HTMLElement,
    85	  ranges: RcTextRange[],
    86	  attr: string,
    87	  styleFor?: (range: RcTextRange) => Partial<CSSStyleDeclaration>,
    88	): void {
    89	  clearMarks(container, attr);
    90	  if (ranges.length === 0) return;
    91	
    92	  for (const range of ranges) {
    93	    if (range.end <= range.start) continue;
    94	    // Re-walk per range: painting mutates the tree, so offsets must be
    95	    // recomputed against the current DOM each time.
    96	    let offset = 0;
    97	    for (const node of textNodes(container)) {
    98	      const length = node.data.length;
    99	      const nodeStart = offset;
   100	      const nodeEnd = offset + length;
   101	      offset = nodeEnd;
   102	
   103	      if (nodeEnd <= range.start || nodeStart >= range.end) continue;
   104	
   105	      const from = Math.max(0, range.start - nodeStart);
   106	      const to = Math.min(length, range.end - nodeStart);
   107	      if (to <= from) continue;
   108	
   109	      // Split the node so the middle piece is exactly the overlap.
   110	      const middle = from > 0 ? node.splitText(from) : node;
   111	      if (to - from < middle.data.length) middle.splitText(to - from);
   112	
   113	      const mark = document.createElement('mark');
   114	      mark.setAttribute(attr, range.color ?? 'true');
   115	      const style = styleFor?.(range);
   116	      if (style) Object.assign(mark.style, style);
   117	      middle.parentNode?.insertBefore(mark, middle);
   118	      mark.appendChild(middle);
   119	    }
   120	  }
   121	}
   122	
   123	/**
   124	 * Paints a student's stored marks onto one surface: the passage, a stem, or a
   125	 * choice. One styling for all of them, so a mark looks the same wherever it
   126	 * sits. Callers pass only the marks that belong to this surface.
   127	 */
   128	export function paintRcAnnotations(container: HTMLElement, highlights: RcHighlight[]): void {
   129	  paintRanges(
   130	    container,
   131	    highlights.map((h) => ({
   132	      start: h.start,
   133	      end: h.end,
   134	      color: h.color,
   135	      kind: h.kind ?? 'highlight',
   136	    })),
   137	    RC_HIGHLIGHT_ATTR,
   138	    (r) =>
   139	      r.kind === 'underline'
   140	        ? {
   141	            backgroundColor: 'transparent',
   142	            textDecoration: 'underline',
   143	            textDecorationColor: 'currentColor',
   144	            textDecorationThickness: '2px',
   145	            textUnderlineOffset: '3px',
   146	          }
   147	        : {
   148	            backgroundColor: rcHighlightColor(r.color),
   149	            // Multiply keeps the text readable through the wash, and matches
   150	            // how the LR player renders its markers.
   151	            mixBlendMode: 'multiply',
   152	          },
   153	  );
   154	}
   155	
   156	/** Case-insensitive matches of `query` in the container's rendered text. */
   157	export function findMatches(container: HTMLElement, query: string): RcTextRange[] {
   158	  if (query.trim().length < 2) return [];
   159	  const haystack = (container.textContent ?? '').toLowerCase();
   160	  const needle = query.toLowerCase();
   161	  const matches: RcTextRange[] = [];
   162	  let from = 0;
   163	  for (;;) {
   164	    const at = haystack.indexOf(needle, from);
   165	    if (at === -1) break;
   166	    matches.push({ start: at, end: at + needle.length });
   167	    from = at + needle.length;
   168	  }
   169	  return matches;
   170	}
   171	
   172	/** Scrolls the nth painted find-match into view. */
   173	export function scrollToMatch(container: HTMLElement, index: number): void {
   174	  const marks = container.querySelectorAll(`mark[${RC_FIND_ATTR}]`);
   175	  const target = marks[index] as HTMLElement | undefined;
   176	  target?.scrollIntoView({ block: 'center', behavior: 'smooth' });
   177	  marks.forEach((m, i) => m.classList.toggle('rc-find-active', i === index));
   178	}

